rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Kes üldse tohib pilve oma ladu hoida
    function allowed() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['ukuprits@gmail.com', 'abcmetall@gmail.com'];
    }

    match /ladu/{userId} {
      // Oma ladu: lugeda ja muuta. Teise ladu: ainult lugeda, kui omanik on sind lubanud (viewers).
      allow read: if allowed()
        && (request.auth.uid == userId || request.auth.token.email in resource.data.viewers);
      allow write: if allowed() && request.auth.uid == userId;
    }

    // Tellimuskirjad Gmailist (meil/Kood.gs kirjutab need). Omanik näeb ja saab peita.
    match /postkast/{kiriId} {
      allow read, delete: if allowed() && request.auth.token.email == resource.data.owner;
    }
  }
}
